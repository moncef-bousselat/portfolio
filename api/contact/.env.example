# Local contact API configuration. Copy to .env (git-ignored) to override the
# defaults in scripts/dev-api.mjs; without a .env those defaults apply.

# console prints the email instead of sending it. ses needs AWS credentials
# and a verified identity - only for deliberately testing SES from a laptop.
MAIL_TRANSPORT=console
MAIL_FROM=contact@localhost.test
MAIL_TO=owner@localhost.test

# Cloudflare's dummy secrets - pair with the matching dummy site key in
# site/.env. Real secrets never go here; production reads SSM.
#   1x0000000000000000000000000000000AA   every token passes
#   2x0000000000000000000000000000000AA   every token fails   (form shows 403)
#   3x0000000000000000000000000000000AA   token already spent (form shows 403)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Per-visitor limit, held in memory here (DynamoDB in Lambda). Locally every
# request is 127.0.0.1, so it applies to you: one message per window, then
# the form shows the "you can send another in N min" message. 0 turns it off.
RATE_LIMIT_WINDOW_SECONDS=60

# CONTACT_API_PORT=8787
