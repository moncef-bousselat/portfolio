{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site for a cloud & DevOps engineer.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "site",
    "api/contact"
  ],
  "scripts": {
    "dev": "concurrently --names site,api --prefix-colors green,cyan --kill-others-on-fail \"npm:dev:site\" \"npm:dev:api\"",
    "dev:site": "npm run dev --workspace site",
    "dev:api": "node --watch --env-file-if-exists=api/contact/.env scripts/dev-api.mjs",
    "build": "npm run build --workspace site",
    "headers": "node scripts/gen-headers.mjs",
    "headers:check": "node scripts/gen-headers.mjs --check",
    "preview": "node scripts/preview.mjs",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"infra/**/*.test.mjs\" \"scripts/**/*.test.mjs\" && npm run test --workspaces --if-present",
    "infra:check": "scripts/infra-check.sh",
    "lint:workflows": "actionlint && zizmor .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript-eslint": "^8.71.2"
  }
}
