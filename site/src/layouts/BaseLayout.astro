---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ogImageEn from '../assets/og/og-en.png';
import ogImageFr from '../assets/og/og-fr.png';
import { languages, defaultLang, pathWithoutLocale, toLang, useTranslations } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/shiki.css';

interface Props {
  title: string;
  description: string;
  /**
   * For pages that must not be indexed, such as the 404. They get a robots
   * noindex and no canonical or hreflang links, since the same file is served
   * at whatever URL was missing.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const basePath = pathWithoutLocale(Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Every page advertises all of its locale variants, plus x-default pointing at
// the default locale, so search engines pair them instead of treating the
// translations as duplicate content.
const alternates = (Object.keys(languages) as (keyof typeof languages)[]).map((code) => ({
  code,
  href: getAbsoluteLocaleUrl(code, basePath),
}));

/*
 * The link preview card (LinkedIn, Slack, X, messaging apps): the page's own
 * title and description, over one share image per language, rendered by
 * npm run og. Imported rather than in public/, so its URL carries a content
 * hash: platforms cache previews per image URL, and a new image is then a
 * new URL. X reads the og: tags too; it only needs to be told the card size.
 */
const ogImage = new URL((lang === 'fr' ? ogImageFr : ogImageEn).src, Astro.site);
const ogLocale = { en: 'en_US', fr: 'fr_FR' } as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(({ code, href }) => (
          <link rel="alternate" hreflang={code} href={href} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={getAbsoluteLocaleUrl(defaultLang, basePath)}
        />
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <!-- "m_" in IBM Plex Mono 600, as paths. The SVG is the one browsers
         use; sizes="32x32" stops Chrome picking the .ico over it, which
         stays for anything that asks for /favicon.ico by name. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Self-hosted @font-face. Deliberately not preloaded; see the fonts
         block in astro.config.mjs for why. -->
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <Analytics />
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={t('site.title')} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={ogLocale[lang]} />
        {(Object.keys(ogLocale) as (keyof typeof ogLocale)[])
          .filter((code) => code !== lang)
          .map((code) => (
            <meta property="og:locale:alternate" content={ogLocale[code]} />
          ))}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${t('site.title')}, ${t('site.role')}`} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skip.content')}
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
