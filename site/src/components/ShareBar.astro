---
import { toLang, useTranslations } from '../i18n';
import { SHARE_PLATFORMS, shareHref } from '../lib/share';

interface Props {
  /** The page title, prefilled where the platform takes one. */
  title: string;
}

const { title } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// The same canonical URL BaseLayout declares, so a shared link never carries
// whatever query string the sharer arrived with.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

/*
 * Brand marks from Simple Icons 16.36.0 (CC0), the two utility glyphs from
 * Lucide 1.63.0 (ISC, (c) Lucide Contributors). Inline, so they cost no
 * request and need no img-src.
 */
const brandPaths: Record<(typeof SHARE_PLATFORMS)[number], string> = {
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  x: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  bluesky:
    'M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026',
  reddit:
    'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z',
};

const platforms = SHARE_PLATFORMS.map((platform) => ({
  platform,
  href: shareHref(platform, pageUrl, title),
  label: t(`share.${platform}`),
  path: brandPaths[platform],
}));
---

{/*
 * A side rail beside the article on wide screens, a bar along the bottom on
 * narrow ones. The platform links are plain links and work without
 * JavaScript; copy link and the system share sheet need it, so they start
 * hidden and the island (islands/share.ts) shows each one only where the
 * browser supports it.
 *
 * rel="noopener" without "noreferrer", as in ExternalLink: the platform may
 * see where the share came from. data-umami-event counts each click as a
 * "share" event with its platform, with no JavaScript of ours.
 *
 * Rendered before the article, as the first child of the page's wrapper:
 * the rail is sticky inside that wrapper, so it follows the reader down the
 * article and stops where the article ends, never over the footer.
 */}
<div class="share-anchor">
  <aside
    class="share"
    aria-label={t('share.label')}
    data-share
    data-url={pageUrl}
    data-title={title}
    data-copied={t('share.copied')}
    data-copy-failed={t('share.copyFailed')}
  >
    <span class="share-label" aria-hidden="true">
      {t('share.label')}
    </span>
    <ul>
      {platforms.map(({ platform, href, label, path }) => (
        <li>
          <a
            class="btn"
            href={href}
            target="_blank"
            rel="noopener"
            title={label}
            data-umami-event="share"
            data-umami-event-platform={platform}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={path} />
            </svg>
            <span class="visually-hidden">
              {label} {t('link.newTab')}
            </span>
          </a>
        </li>
      ))}
      <li hidden data-copy-item>
        <button class="btn" type="button" title={t('share.copy')} data-copy>
          <svg
            class="icon-copy"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <svg
            class="icon-done"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span class="visually-hidden">{t('share.copy')}</span>
        </button>
      </li>
      <li hidden data-native-item>
        <button class="btn" type="button" title={t('share.more')} data-native>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />
          </svg>
          <span class="visually-hidden">{t('share.more')}</span>
        </button>
      </li>
    </ul>
    <span class="visually-hidden" role="status" data-share-status></span>
  </aside>
</div>

<script>
  import '../islands/share';
</script>

<style>
  /* Narrow screens: a bar fixed along the bottom of the viewport. */
  .share {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    padding-block-end: max(var(--space-2), env(safe-area-inset-bottom));
    background: var(--color-surface);
    border-block-start: var(--border-width) solid var(--color-divider);
  }

  /* Room under the footer, so the bar never covers the end of the page. */
  :global(body) {
    padding-block-end: calc(var(--size-control) + 2 * var(--space-2) + var(--border-width));
  }

  /* Six 44px buttons and their gaps fill a 360px phone, so the label only
     shows where there is room beside them. */
  .share-label {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  @media (min-width: 30rem) {
    .share-label {
      display: inline;
    }
  }

  ul {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--size-control);
    block-size: var(--size-control);
    padding: 0;
    color: var(--color-text-muted);
    background: transparent;
    border: var(--border-width) solid var(--color-border-control);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .icon-done,
  [data-done] .icon-copy {
    display: none;
  }

  [data-done] .icon-done {
    display: block;
    color: var(--color-accent);
  }

  /*
   * Wide screens: a vertical rail in the margin left of the article. 60rem
   * leaves the rail clear of the text: --width-content (48rem) plus a rail
   * and its gap on each side. Media queries cannot read custom properties,
   * so the figure is written out.
   */
  @media (min-width: 60rem) {
    :global(body) {
      padding-block-end: 0;
    }

    .share-anchor {
      position: sticky;
      inset-block-start: var(--space-9);
      block-size: 0;
    }

    .share {
      position: absolute;
      inset-block: var(--space-6) auto;
      inset-inline: auto calc(100% + var(--space-5));
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-2);
      border: var(--border-width) solid var(--color-divider);
      border-radius: var(--radius-md);
    }

    .share-label {
      display: none;
    }

    ul {
      flex-direction: column;
    }
  }
</style>
