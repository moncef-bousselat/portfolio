# Copy to terraform.tfvars (git-ignored) and fill in.

aws_region = "eu-west-1"

# Same slug as infra/bootstrap, so names and tags line up across stacks.
project = "portfolio"

# MUST equal site_bucket_name in infra/bootstrap/terraform.tfvars - the
# deploy role's policy names this bucket, and nothing else checks it.
site_bucket_name = "CHANGE-ME-portfolio-site"

# PriceClass_100 (North America + Europe) is the cheapest. PriceClass_All
# serves from every edge location.
# price_class = "PriceClass_100"

# --- Domain ----------------------------------------------------------------

# null (or omitted) serves the site at its *.cloudfront.net address.
# Must match `site` in site/astro.config.mjs.
domain_name = "example.com"

# false: adopt an existing zone (a Route 53-registered domain has one).
# true:  create the zone. If the registrar is outside Route 53, apply in two
#        steps, because the certificate cannot validate until the registrar
#        delegates to the new zone:
#          terraform apply -target=aws_route53_zone.site
#          (set the `name_servers` output at the registrar, wait for it)
#          terraform apply
create_hosted_zone = false

# www.<domain> also resolves, and 301s to the apex.
enable_www_redirect = true

# --- Cost guardrail --------------------------------------------------------

budget_limit_usd   = 5
budget_alert_email = "you@example.com"

# --- Contact form ----------------------------------------------------------

# The one address submissions are sent to. Sensitive: never commit it.
contact_recipient_email = "you@example.com"

# Sender. Omit for contact@<domain_name> (the domain is verified in SES
# through DKIM records this stack writes). Required without a domain.
# ses_from_email = "contact@example.com"

# DMARC for the domain when the sender is on it: none (report only, the
# default), quarantine or reject. null writes no record.
# dmarc_policy = "none"

# The Turnstile secret key lives in SSM, created by hand - Terraform reads
# only its name, so the value never enters state:
#   read -rs TS_SECRET && aws ssm put-parameter --region <aws_region> \
#     --name /<project>/turnstile-secret --type SecureString \
#     --value "$TS_SECRET" && unset TS_SECRET
# turnstile_secret_parameter_name = "/portfolio/turnstile-secret"

# Abuse and cost limits. Reserving concurrency fails on an account still on
# Lambda's default quota of 10 (aws lambda get-account-settings); set -1 then.
# contact_throttle_rate_limit  = 1
# contact_throttle_burst_limit = 5
# contact_reserved_concurrency = 2
# log_retention_days           = 14

# One message per visitor (IP, or IPv6 /64) per this many seconds; 0 is off.
# contact_rate_limit_window_seconds = 300

# --- Cost kill switch --------------------------------------------------------

# Disables the CloudFront distribution and emails budget_alert_email when the
# estimated CloudFront cost crosses either threshold. SNS sends a
# confirmation link to that address on the first apply: click it, or the
# notice never arrives. Reopen with the "Reopen site" workflow.
# kill_switch_enabled   = true
# kill_switch_fast_usd  = 0.5 # in any 5 minutes
# kill_switch_daily_usd = 2   # in any 24 hours
